NODE_ENV=production
PORT=4000
FRONTEND_URL=https://*.vercel.app,http://localhost:3000
ADMIN_URL=http://localhost:3001
BACKEND_URL=https://digital-bizware-1.onrender.com
API_PUBLIC_URL=https://digital-bizware-1.onrender.com/api

# MongoDB Atlas
MONGODB_URI=

# Session cookies (leave blank for default cross-origin, or set domain for custom root domain)
COOKIE_DOMAIN=
SESSION_DAYS=7

# Cloudinary (covers and thumbnails only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (private PDFs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_REGION=auto

# Razorpay keys and webhook signing secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Digital Bizware"
ADMIN_NOTIFICATION_EMAIL=

# Upload and signed download limits
PDF_MAX_SIZE_MB=50
SIGNED_URL_EXPIRY_SECONDS=60

# First administrator (used only by the seed:admin command)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
